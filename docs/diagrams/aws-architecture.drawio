             VPC Origin). Placed below Secrets Manager to avoid the VPC/EKS boxes. -->
        <mxCell id="cloudfront" value="CloudFront (opt-in)&#xa;signed URLs" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudfront;" vertex="1" parent="awscloud">
          <mxGeometry x="120" y="640" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- VPC container (child of awscloud) -->
        <mxCell id="vpc" value="VPC &#183; aws_region &#183; 10.20.0.0/16 (3 AZ, NAT per-AZ)" style="sketch=0;outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#248814;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="awscloud">
          <mxGeometry x="210" y="90" width="860" height="710" as="geometry" />
        </mxCell>

