          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- pod1 -> aurora -->
        <mxCell id="e_pod_db" value="SQL (schema pr_&amp;lt;n&amp;gt;)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#C925D1;dashed=1;" edge="1" parent="1" source="pod1" target="aurora">
