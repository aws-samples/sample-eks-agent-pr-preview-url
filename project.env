# project.env — the single place to configure this deployment.
#
# Three knobs derive every named AWS/Kubernetes resource. Copy this file, set the
# values for your account, and `source project.env` before running scripts, or
# pass them to CDK/Helm/workflows as shown in docs/runbook.md.
#
#   project_name  → cluster name, ECR repo, IAM deploy role, node instance profile,
#                   Secrets Manager path prefix, k8s label domain, ALB group name,
#                   CloudFormation stack prefix.
#   github_org    → the GitHub org whose repos may assume the deploy role (OIDC).
#   aws_region    → the region everything is provisioned in.
#
# Keep project_name short (<= ~20 chars): it seeds the EKS cluster name, ECR repo,
# IAM role name (64-char cap), node profile, and secret prefix. Lowercase, digits,
# and hyphens only. (The local `kind` cluster is always named `pr-preview`.)

# Local overrides: if a gitignored project.local.env exists, load it FIRST so its
# values seed the `${VAR:-default}` derivations below. This is why editing
# project.local.env "just works" without touching this tracked template.
if [ -f "$(dirname "${BASH_SOURCE[0]:-project.env}")/project.local.env" ]; then
  # shellcheck source=/dev/null
  . "$(dirname "${BASH_SOURCE[0]:-project.env}")/project.local.env"
fi

export PROJECT_NAME="${PROJECT_NAME:-pr-preview}"
export GITHUB_ORG="${GITHUB_ORG:-your-org}"
export AWS_REGION="${AWS_REGION:-us-east-1}"

# --- Derived (do not usually edit) -----------------------------------------
# Exposed so scripts and the eksctl-config renderer can read one canonical set.
export CLUSTER_NAME="${CLUSTER_NAME:-$PROJECT_NAME}"
export ECR_REPOSITORY="${ECR_REPOSITORY:-$PROJECT_NAME/app}"
export DEPLOY_ROLE_NAME="${DEPLOY_ROLE_NAME:-$PROJECT_NAME-github-deploy}"
export NODE_INSTANCE_PROFILE="${NODE_INSTANCE_PROFILE:-$PROJECT_NAME-nodes}"
export SECRET_PREFIX="${SECRET_PREFIX:-$PROJECT_NAME/preview}"
export IMAGE_REPO="${IMAGE_REPO:-$ECR_REPOSITORY}"